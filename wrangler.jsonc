{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "racket-events-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat_v2"],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "MONITOR_STATE",
      "id": "b8d946b698ab40329051246e0e90eebb"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOIN_COORDINATOR",
        "class_name": "JoinCoordinator"
      },
      {
        "name": "OPERATION_LOGS",
        "class_name": "OperationLogStore"
      },
      {
        "name": "MONITOR_SCHEDULER",
        "class_name": "MonitorScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JoinCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OperationLogStore"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["MonitorScheduler"]
    }
  ],
  "alias": {
    "debug": "./src/debug-stub.ts"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "GROUP_ID": "IenuPng40UmpsU",
        "JOIN_DEBUG_SCREENSHOTS": "false"
      },
      "kv_namespaces": [
        {
          "binding": "MONITOR_STATE"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "JOIN_COORDINATOR",
            "class_name": "JoinCoordinator"
          },
          {
            "name": "OPERATION_LOGS",
            "class_name": "OperationLogStore"
          },
          {
            "name": "MONITOR_SCHEDULER",
            "class_name": "MonitorScheduler"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["JoinCoordinator"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["OperationLogStore"]
        },
        {
          "tag": "v3",
          "new_sqlite_classes": ["MonitorScheduler"]
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  }
}
